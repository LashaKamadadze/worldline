{
  "name": "browser-tests",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Headless-browser tests for @kamadadze/worldline (OPFS adapter and full sync against a real local SpacetimeDB)",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "spacetime generate --yes --lang typescript --out-dir generated/module_bindings --module-path ../../examples/todo-module"
  },
  "dependencies": {
    "spacetimedb": "2.10.0",
    "@kamadadze/worldline": "workspace:*",
    "todo-module": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.0",
    "playwright-core": "1.61.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
